# Backend environment variables
# Copy this file to .env and fill in the values.
# .env is never committed to git.

# ── Security ──────────────────────────────────────────────────────────────────
# Used to encrypt on-disk session files and temporary 2FA passwords in memory.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production (server refuses to start without it).
# In development, omitting this falls back to a hardcoded dev key (insecure).
SECRET_KEY=change-me-in-production

# Set to "true" in production (HTTPS deployment).
# When true: cookies are Secure + SameSite=None (cross-origin HTTPS).
# When false: cookies are SameSite=Lax (works for localhost HTTP).
COOKIE_SECURE=false

# Set to "production" to enforce SECRET_KEY and enable HSTS headers.
ENVIRONMENT=development

# ── Instagram proxy (avoids datacenter IP bans) ──────────────────────────────
# Cloud provider IPs (Railway, Render, AWS, etc.) are blocked by Instagram.
# Set a residential proxy to route instagrapi requests through a clean IP.
# Format: socks5://user:pass@host:port  OR  http://host:port
# Free option: WebShare.io (10 proxies, 1GB/mo free tier)
# Leave empty to use the server's own IP (fine for local development).
INSTAGRAM_PROXY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3000

# ── Redis (sessions + profile-count cache) ────────────────────────────────────
# Leave empty to use in-memory sessions (dev only — sessions are lost on restart).
# Production: get a free Redis URL from https://upstash.com
REDIS_URL=

# ── Database (users + subscriptions + Pro history) ────────────────────────────
# Leave empty until subscriptions are implemented.
DATABASE_URL=

# ── Stripe (subscriptions) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
